# Catchup backend configuration.
# Copy to .env and fill in values local to your environment.

# PostgreSQL connection string (managed Supabase works too).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/catchup

# CORS: comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Market data provider.
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=3

# Ingestion.
INGESTION_INTERVAL_SECONDS=300
INGESTION_ENABLED=false

# Freshness policy (minutes). Freshness uses the provider quote timestamp, not
# the local poll time.
DELAYED_THRESHOLD_MINUTES=5
STALE_THRESHOLD_MINUTES=30

# Baseline configuration (trading days).
BASELINE_WINDOW_DAYS=30
MIN_BASELINE_RETURNS=20
LIMITED_BASELINE_RETURNS=5

# Significance thresholds (deterministic). Percentage returns are absolute.
PRICE_NOTABLE_THRESHOLD=2.0
PRICE_SIGNIFICANT_THRESHOLD=4.0
PRICE_CRITICAL_THRESHOLD=7.0
PRICE_NOTABLE_Z=1.5
PRICE_SIGNIFICANT_Z=2.0
PRICE_CRITICAL_Z=3.0

# Volume thresholds.
VOLUME_NOTABLE_RATIO=2.0
VOLUME_SIGNIFICANT_RATIO=3.0

# Logging level.
LOG_LEVEL=INFO
